---
import CardChoose from "../ui/CardChoose.astro"
import ChooseTeacher from "../../assets/choose-teacher.png"
import ChooseCreative from "../../assets/choose-creative.png"
import ChooseAppropriate from "../../assets/choose-appropriate.png"
---

<section id="choose" class="py-5 my-5">
    <header class="d-flex justify-content-center align-items-center flex-column text-center mb-5 pb-3">
        <h2 class="fw-bold col-12 col-md-6 col-lg-6">Why should you choose Edudu?</h2>
    </header>
    <section class="bg-warning  position-relative">
        <section class="position-absolute w-100 top-0 start-50 translate-middle d-flex flex-wrap justify-content-center align-items-center gap-5">
            <CardChoose title="Experienced teacher" description="Instructors from all over Vietnam and around the world, providing quality learning experiences and helping students develop their full potential" image={ChooseTeacher} />
            <CardChoose title="Creative program" description="Flexible payment, suitable to personal financial situation and study schedule. Pay monthly, by course or “study now, pay later”" image={ChooseCreative} />
            <CardChoose title="Appropriate cost" description="Thiết kế giáo trình dựa trên năng lực và nhu cầu từng học viên, hoạt động học tập hấp dẫn, tương tác 2 chiều liên tục. " image={ChooseAppropriate} />
        </section>
    </section>
</section>

<style>
    .bg-warning {
        height: 200px;
        margin-top: 220px !important;
    }
    
</style>